# ─── Local LLM (OpenAI-compatible server) ────────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-local-api-key
LLM_MODEL=your-model-name

# ─── Jira ────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ                  # comma-separated for multiple: PROJ,TEAM

# ─── Bitbucket ───────────────────────────────────────────────────────────────
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_USERNAME=your-bitbucket-username
BITBUCKET_APP_PASSWORD=your-app-password
BITBUCKET_WORKSPACE=your-workspace-slug
BITBUCKET_REPOS=auth-service,payment-api,web-frontend   # comma-separated repo slugs

# Bug → Repo mapping (Jira component name : Bitbucket repo slug)
# Format: component1:repo-slug1,component2:repo-slug2
BUG_REPO_MAP=auth-service:auth-service-api,payment:payment-service

# ─── Confluence ───────────────────────────────────────────────────────────────
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USERNAME=you@yourcompany.com
CONFLUENCE_PASSWORD=your-confluence-password

# ─── Memory ──────────────────────────────────────────────────────────────────
MEMORY_DB_PATH=~/.pattu/memory.db
MEMORY_CACHE_TTL_MINUTES=15
