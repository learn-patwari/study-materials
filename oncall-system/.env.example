# ── Provider ──────────────────────────────────────────────────────────────────
# Choose: "twilio" or "exotel"
PROVIDER=twilio

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///oncall.db

# ── Twilio (https://console.twilio.com) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_CALLER_ID=+91XXXXXXXXXX

# ── Exotel (https://my.exotel.com) ───────────────────────────────────────────
EXOTEL_SID=your_exotel_sid
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=0XXXXXXXXXX
EXOTEL_APP_ID=your_app_id

# ── P3 Knox / Fallback ────────────────────────────────────────────────────────
# Samsung Knox Manage API (leave blank to use fallback webhook)
KNOX_API_URL=https://your-knox-server/api/push
KNOX_API_KEY=your_knox_bearer_token

# Generic fallback webhook for P3 (e.g. Slack, Teams, custom push)
P3_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of this server (for Exotel callbacks)
BASE_URL=https://your-domain.com
